# Variables d'environnement de l'API (copier en .env pour le développement local).
# Validées au démarrage : une valeur absente ou invalide arrête l'API avec un message clair.

# development | test | production (défaut : development)
NODE_ENV=development

# Port HTTP, entre 1 et 65535 (défaut : 3000)
PORT=3000

# Obligatoire. Base PostgreSQL locale lancée par docker compose (voir la racine du dépôt).
DATABASE_URL=postgres://stepbystep:stepbystep@localhost:5432/stepbystep
