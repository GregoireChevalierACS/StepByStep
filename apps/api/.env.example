# Variables d'environnement de l'API (copier en .env pour le développement local).
# Validées au démarrage : une valeur absente ou invalide arrête l'API avec un message clair.

# development | test | production (défaut : development)
NODE_ENV=development

# Port HTTP, entre 1 et 65535 (défaut : 3000)
PORT=3000

# Obligatoire. Base PostgreSQL locale lancée par docker compose (voir la racine du dépôt).
DATABASE_URL=postgres://stepbystep:stepbystep@localhost:5432/stepbystep

# Obligatoire, 32 caractères au moins. Clé de signature des jetons d'appareil (JWT).
# Valeur de développement seulement : en production, une clé aléatoire propre à l'environnement
# (par exemple : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
JWT_SECRET=cle-de-developpement-local-a-ne-jamais-utiliser-en-production

# Intervalle en millisecondes du relais qui publie les événements de l'outbox (défaut : 5000).
# 0 désactive le relais.
OUTBOX_RELAY_INTERVAL_MS=5000
