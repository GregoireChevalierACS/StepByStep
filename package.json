{
  "name": "stepbystep",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky && pnpm --filter @stepbystep/domain build",
    "lint": "eslint .",
    "lint:architecture": "depcruise apps packages --config .dependency-cruiser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "smoke:api": "node scripts/smoke-api.mjs",
    "typecheck": "pnpm --filter @stepbystep/domain build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:mutation": "pnpm --filter @stepbystep/domain test:mutation",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @stepbystep/api build && pnpm --filter @stepbystep/api db:migrate",
    "db:revert": "pnpm --filter @stepbystep/api build && pnpm --filter @stepbystep/api db:revert"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
